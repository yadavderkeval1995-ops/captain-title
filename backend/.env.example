# Fresh MongoDB Atlas database. Never reuse the Emergent MONGO_URL.
MONGO_URL=mongodb+srv://captain_app:<password>@<cluster-host>/?retryWrites=true&w=majority
DB_NAME=captain_title

# Fresh authentication material. Generate independently for each environment.
SESSION_PEPPER=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Browser security
FRONTEND_URL=https://<frontend-domain>
CORS_ORIGINS=https://<frontend-domain>

# Direct OpenAI API. Never reuse EMERGENT_LLM_KEY.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TEXT_MODEL=gpt-5.6-terra

# Cloudflare R2 or another S3-compatible private bucket.
S3_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=captain-title-media
S3_REGION=auto

# Stripe remains optional until configured for the chosen business setup.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Production safety
UNLIMITED_TESTING=false

# Copy this file to .env and fill in the values.

# MongoDB connection. For local dev, point this at a local mongod
# (mongodb://localhost:27017) or a free MongoDB Atlas cluster.
MONGO_URL=mongodb://localhost:27017
DB_NAME=captain_title

# Sarvam AI API key. Sarvam's REST API doesn't support word-level
# timestamps, so it's used only to recognize *what* was said (it's far more
# accurate than Whisper for Hindi/Hinglish) - Whisper below still supplies
# the per-word *timing*, and the two are stitched together.
# Get one at https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Optional: override the Sarvam STT model. Defaults to saaras:v4.
# SARVAM_STT_MODEL=saaras:v4

# OpenAI API key. Used for Whisper's word-level timestamps (timing only,
# its recognized text is discarded in favor of Sarvam's) and for the
# Hindi -> Hinglish caption conversion pass.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: override the chat model used for Hinglish conversion.
# Defaults to gpt-4o for quality. Set to gpt-4o-mini for lower cost/latency
# if quality is good enough for your content.
# CAPTION_LLM_MODEL=gpt-4o

# Where uploaded videos, previews, and rendered exports are stored on disk.
# Defaults to backend/storage_data if unset. Fine for personal use;
# swap for real object storage (S3, R2, etc.) before going multi-user.
# LOCAL_STORAGE_DIR=./storage_data

# Optional: lets you process videos up to 120s without spending credits,
# useful while developing locally.
# UNLIMITED_TESTING=true

# Stripe (only needed once you turn on paid plans). Leave unset and the
# /api/payments/catalog endpoint will report checkout as unavailable.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
